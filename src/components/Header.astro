---
import { Image } from 'astro:assets';
import icLogo from '@assets/ic-icon-transparent-256.png';
import NavButton from "@components/elements/NavButton.astro";
---

<nav class="sticky top-0 flex py-4 items-center bg-slate-950">
    <a href="/" class="rounded-sm focus:ring-4 focus:ring-gray-400 focus:outline-none">
        <Image src={icLogo} alt="IC" width="60"/>
    </a>
    <div class="flex-1"/>
    <NavButton href="/" name="Home" />
    <NavButton href="/experience" name="Experience" />
    <NavButton href="/projects" name="Projects" />
    <NavButton href="/personal" name="Personal" />
</nav>