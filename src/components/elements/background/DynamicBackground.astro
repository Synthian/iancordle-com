---
---
<div class="fixed -z-1 left-0 top-0 w-screen h-screen bg-zinc-900">
    <div class="blob top-1/12 bg-teal-600 animate-[drift-1]" />
    <div class="blob top-3/12 left-3/12 bg-cyan-600 animate-[drift-2]" />
    <div class="blob top-8/12 left-2/12 bg-indigo-600 animate-[drift-3]" />

    <div class="blob left-7/12 bg-violet-600 animate-[drift-4]" />
    <div class="blob top-5/12 left-10/12 bg-sky-600 animate-[drift-5]" />
    <div class="blob top-10/12 left-7/12 bg-lime-600 animate-[drift-6]" />
</div>

<style>
    .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.1;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
        animation-direction: alternate;
        animation-duration: 20s;
        width: 30vmax;
        height: 30vmax;
    }

    @keyframes drift-1 {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(8vmax, -1vmax) scale(1.15); }
        100% { transform: translate(5vmax, -4vmax) scale(0.95); }
    }

    @keyframes drift-2 {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-7vmax, 10vmax) scale(1.08); }
        100% { transform: translate(-2vmax, 3vmax) scale(0.92); }
    }

    @keyframes drift-3 {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-10vmax, -2vmax) scale(1.12); }
        100% { transform: translate(-4vmax, -1vmax) scale(0.98); }
    }

    @keyframes drift-4 {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(10vmax, -8vmax) scale(1.2); }
        100% { transform: translate(6vmax, 5vmax) scale(0.9); }
    }

    @keyframes drift-5 {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-5vmax, 9vmax) scale(1.1); }
        100% { transform: translate(-8vmax, -2vmax) scale(1.02); }
    }

    @keyframes drift-6 {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-5vmax, -9vmax) scale(1.1); }
        100% { transform: translate(-8vmax, -2vmax) scale(1.02); }
    }
</style>