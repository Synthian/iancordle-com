---
---
<div class="fixed -z-1 left-0 top-0 w-screen h-screen bg-zinc-900 overflow-hidden">
    <div class="blob blob-teal -top-1/12 -left-1/12 animate-[drift-1]" />
    <div class="blob blob-cyan top-1/12 left-2/12 animate-[drift-2]" />
    <div class="blob blob-indigo top-6/12 animate-[drift-3]" />

    <div class="blob blob-violet left-5/12 -top-2/12 animate-[drift-4]" />
    <div class="blob blob-sky top-3/12 left-8/12 animate-[drift-5]" />
    <div class="blob blob-lime top-8/12 left-5/12 animate-[drift-6]" />
</div>

<style>
    .blob {
        position: absolute;
        border-radius: 50%;
        will-change: transform;
        opacity: 0.11;
        width: 45vmax;
        height: 45vmax;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
        animation-direction: alternate;
        animation-duration: 20s;
    }

    .blob-teal {
        background: radial-gradient(circle farthest-side, var(--color-teal-600) 0%, oklch(from var(--color-teal-600) l c h / 0.6) 60%, oklch(from var(--color-teal-600) l c h / 0) 100%);
    }
    .blob-cyan {
        background: radial-gradient(circle farthest-side, var(--color-cyan-600) 0%, oklch(from var(--color-cyan-600) l c h / 0.6) 60%, oklch(from var(--color-cyan-600) l c h / 0) 100%);
    }
    .blob-indigo {
        background: radial-gradient(circle farthest-side, var(--color-indigo-600) 0%, oklch(from var(--color-indigo-600) l c h / 0.6) 60%, oklch(from var(--color-indigo-600) l c h / 0) 100%);
    }
    .blob-violet {
        background: radial-gradient(circle farthest-side, var(--color-violet-600) 0%, oklch(from var(--color-violet-600) l c h / 0.6) 60%, oklch(from var(--color-violet-600) l c h / 0) 100%);
    }
    .blob-sky {
        background: radial-gradient(circle farthest-side, var(--color-sky-600) 0%, oklch(from var(--color-sky-600) l c h / 0.6) 60%, oklch(from var(--color-sky-600) l c h / 0) 100%);
    }
    .blob-lime {
        background: radial-gradient(circle farthest-side, var(--color-lime-600) 0%, oklch(from var(--color-lime-600) l c h / 0.6) 60%, oklch(from var(--color-lime-600) l c h / 0) 100%);
    }

    @keyframes drift-1 {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(8vmax, -1vmax, 0); }
        100% { transform: translate3d(5vmax, -4vmax, 0); }
    }

    @keyframes drift-2 {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(-7vmax, 10vmax, 0); }
        100% { transform: translate3d(-2vmax, 3vmax, 0); }
    }

    @keyframes drift-3 {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(-10vmax, -2vmax, 0); }
        100% { transform: translate3d(-4vmax, -1vmax, 0); }
    }

    @keyframes drift-4 {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(10vmax, -8vmax, 0); }
        100% { transform: translate3d(6vmax, 5vmax, 0); }
    }

    @keyframes drift-5 {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(-5vmax, 9vmax, 0); }
        100% { transform: translate3d(-8vmax, -2vmax, 0); }
    }

    @keyframes drift-6 {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(-5vmax, -9vmax, 0); }
        100% { transform: translate3d(-8vmax, -2vmax, 0); }
    }
</style>