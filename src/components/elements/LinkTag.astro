---
import {Icon} from "astro-icon/components";
const { href, icon, gradientClasses } = Astro.props;
---
<a href={href} class=`not-prose relative top-0.5 inline-flex items-center gap-1
                    text-white rounded-md px-1.5 bg-linear-to-tr ${gradientClasses}
                      transition-all hover:saturate-200`>
    <Icon name={icon} />
    <slot/>
</a>