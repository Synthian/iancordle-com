---
import TimelineEvent from "@components/content/TimelineEvent.astro";
---
<div class="relative overflow-hidden flex flex-col">
    <div class="absolute left-1/2 -translate-x-0.5 w-1 bg-white h-full mask-(--timeline-mask)" />
    <div class="h-5"/>
    <TimelineEvent year="2020" text="COVID fucked everything up and then some. What a doozy!" colorClass="bg-amber-500" />
    <TimelineEvent year="2025" text="I baked a lot of cookies" colorClass="bg-cyan-500" />
    <TimelineEvent year="2026" text="Made this website!" colorClass="bg-red-500" />
    <div class="h-5" />
</div>
