---
import TimelineEvent from "@components/content/TimelineEvent.astro";
---
<div class="relative overflow-hidden flex flex-col gap-3 md:gap-0">
    <div class="absolute left-4 md:left-1/2 -translate-x-0.5 w-1 bg-white h-full mask-(--timeline-mask)" />
    <div class="h-5"/>
    <TimelineEvent year="Summer 2017" colorClass="bg-teal-400" >
        Interned at DICK'S Sporting Goods as an Android Developer
    </TimelineEvent>
    <TimelineEvent year="Spring 2018" colorClass="bg-cyan-500" >
        Graduated from Penn State University with a Bachelors in Computer Science
    </TimelineEvent>
    <TimelineEvent year="August 2018"  colorClass="bg-indigo-500" >
        Started at FedEx as a Software <span class="whitespace-nowrap">Developer I</span>
    </TimelineEvent>
    <TimelineEvent year="April 2020"  colorClass="bg-fuchsia-400" >
        Promoted to Full Stack Developer II at FedEx
    </TimelineEvent>
    <TimelineEvent year="May 2021"  colorClass="bg-teal-500" >
        Released a <a href="https://github.com/Synthian/BastionBot">Discord bot</a> for the Bastion Speedrunning community.
    </TimelineEvent>
    <TimelineEvent year="June 2021"  colorClass="bg-sky-500" >
        Released a Binding of Isaac Mod, <a href="https://steamcommunity.com/sharedfiles/filedetails/?id=2508822241">Cadaver: The Rotten Expansion</a>
    </TimelineEvent>
    <TimelineEvent year="January 2022"  colorClass="bg-purple-600" >
        Promoted to Full Stack Developer III at FedEx
    </TimelineEvent>
    <TimelineEvent year="June 2023"  colorClass="bg-blue-600" >
        Promoted to Full Stack Developer Advisor at FedEx
    </TimelineEvent>
    <div class="h-5" />
</div>
