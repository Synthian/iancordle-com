---
import { Icon } from 'astro-icon/components';
---
<div class="flex justify-center">
    <div class="inline-flex flex-wrap justify-center text-4xl p-2 m-1 gap-4
                md:m-2 md:p-4 md:text-6xl md:gap-6
                bg-white/6 border border-white/8 rounded-2xl shadow">
        <Icon class="text-[#61DBFB]" name="simple-icons:react" />
        <Icon class="text-[#6DB33B]" name="simple-icons:spring" />
        <Icon class="text-[#3178C6]" name="simple-icons:typescript" />
        <Icon class="text-[#3DDC84]" name="simple-icons:android" />
        <Icon class="text-[#F1502F]" name="simple-icons:git" />
        <Icon class="text-[#D82C20]" name="simple-icons:redis" />
    </div>
</div>