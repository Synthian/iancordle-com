---
import Header from '@components/Header.astro';
import Prose from '@components/elements/Prose.astro';
import Footer from '@components/Footer.astro';
import "@styles/global.css";
import { Font } from 'astro:assets';
import DynamicBackground from "@components/elements/DynamicBackground.astro";

const title = Astro.props.title ?? Astro.props.frontmatter.title;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<Font cssVariable="--font-poppins" />
		<link rel='icon' type='image/png' href='/ic-icon-16.png' sizes='16x16' />
        <link rel='icon' type='image/png' href='/ic-icon-32.png' sizes='32x32' />
		<link rel='icon' type='image/png' href='/ic-icon-128.png' sizes='128x128' />
		<title>IC | {title}</title>
	</head>
	<body class="bg-zinc-900 text-white flex flex-col">
		<DynamicBackground zIndex="-1" />
		<div class="flex flex-col max-w-4xl w-full m-auto *:px-6 flex-1">
			<Header />
			<Prose>
				<slot />
			</Prose>
		</div>
		<Footer />
	</body>

	<style>
		html,
		body {
			margin: 0;
			width: 100%;
			height: 100%;
		}
	</style>
</html>
