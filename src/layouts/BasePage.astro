---
import Header from '@components/Header.astro';
import "@styles/global.css";
import { Font } from 'astro:assets';
import DynamicBackground from "@components/elements/DynamicBackground.astro";

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<Font cssVariable="--font-poppins" />
		<link rel='icon' type='image/png' href='/ic-icon-16.png' sizes='16x16' />
        <link rel='icon' type='image/png' href='/ic-icon-32.png' sizes='32x32' />
		<title>IC | {title}</title>
	</head>
	<body class="bg-zinc-900">
		<DynamicBackground />
		<div class="max-w-4xl m-auto px-4">
			<Header />
			<slot />
		</div>
	</body>

	<style>
		html,
		body {
			margin: 0;
			width: 100%;
			height: 100%;
		}
	</style>
</html>
